---
// src/components/Navbar.astro
interface Props {
  brand?: string;
}

const { brand = "markus-ankerstein.de" } = Astro.props;

const links = [
  { href: "/", label: "Start" },
  { href: "/leistungen", label: "Leistungen" },
  { href: "/projekte", label: "Projekte" },
  { href: "/ueber-uns", label: "Über uns" },
  { href: "/kontakt", label: "Kontakt", cta: true },
];

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) =>
  href === "/"
    ? pathname === "/"
    : pathname === href || pathname.startsWith(`${href}/`);
---

<header
  class="sticky top-0 z-50 border-b border-white/20 bg-zinc-700 shadow-lg shadow-black/10"
>
  <nav
    aria-label="Hauptnavigation"
    class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8"
  >
    <!-- Logo + Text (links) -->
    <a
      href="/"
      class="group flex items-center gap-3 rounded-lg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
    >
      <img src="/logo_weiss_70x70.png" alt="" class="size-9 hover:-rotate-7" />
      <span
        class=" font-normal font-mono text-[1rem] tracking-tight text-white"
        >{brand}</span
      >
    </a>

    <!-- Seitenlinks (rechts, Desktop) -->
    <ul class="hidden items-center gap-1 md:flex">
      {
        links.map((link) => (
          <li>
            {link.cta ? (
              <a
                href={link.href}
                class="ml-2 inline-flex items-center rounded-xl bg-zinc-100 px-4 py-2 text-sm uppercase font-mono font-normal text-zinc-900 transition hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
                aria-current={isActive(link.href) ? "page" : undefined}
              >
                {link.label}
              </a>
            ) : (
              <a
                href={link.href}
                aria-current={isActive(link.href) ? "page" : undefined}
                class:list={[
                  "rounded-lg px-4 py-2 text-sm tracking-widest uppercase font-normal font-mono transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white",
                  isActive(link.href)
                    ? "bg-white/15 text-white"
                    : "text-zinc-200 hover:bg-white/10 hover:text-white",
                ]}
              >
                {link.label}
              </a>
            )}
          </li>
        ))
      }
    </ul>

    <!-- Menü-Button (Mobil) -->
    <button
      id="menu-toggle"
      type="button"
      class="group relative grid size-10 place-items-center rounded-lg text-white transition hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Menü öffnen"
    >
      <span class="sr-only">Menü</span>
      <span
        class="absolute h-0.5 w-5 -translate-y-1.5 rounded bg-current transition-transform duration-300 motion-reduce:transition-none group-aria-expanded:translate-y-0 group-aria-expanded:rotate-45"
      ></span>
      <span
        class="absolute h-0.5 w-5 rounded bg-current transition-opacity duration-200 motion-reduce:transition-none group-aria-expanded:opacity-0"
      ></span>
      <span
        class="absolute h-0.5 w-5 translate-y-1.5 rounded bg-current transition-transform duration-300 motion-reduce:transition-none group-aria-expanded:translate-y-0 group-aria-expanded:-rotate-45"
      ></span>
    </button>
  </nav>

  <!-- Mobiles Menü -->
  <div
    id="mobile-menu"
    data-open="false"
    class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 motion-reduce:transition-none data-[open=true]:grid-rows-[1fr] md:hidden"
  >
    <div class="overflow-hidden" inert>
      <ul
        class="flex flex-col gap-1 border-t border-white/10 px-4 py-3 sm:px-6"
      >
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? "page" : undefined}
                class:list={[
                  "block rounded-xl px-4 py-3 text-base font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white",
                  link.cta
                    ? "mt-2 bg-zinc-100 text-center text-zinc-900 hover:bg-white"
                    : isActive(link.href)
                      ? "bg-white/15 text-white"
                      : "text-zinc-200 hover:bg-white/10 hover:text-white",
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const inner = menu?.firstElementChild as HTMLElement | null;

  function setOpen(open: boolean) {
    if (!toggle || !menu || !inner) return;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Menü schließen" : "Menü öffnen");
    menu.dataset.open = String(open);
    inner.toggleAttribute("inert", !open);
  }

  toggle?.addEventListener("click", () => {
    setOpen(toggle.getAttribute("aria-expanded") !== "true");
  });

  menu?.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) setOpen(false);
  });

  document.addEventListener("keydown", (e) => {
    if (
      e.key === "Escape" &&
      toggle?.getAttribute("aria-expanded") === "true"
    ) {
      setOpen(false);
      toggle.focus();
    }
  });

  window.matchMedia("(min-width: 768px)").addEventListener("change", (e) => {
    if (e.matches) setOpen(false);
  });
</script>
