---
interface Props {
  mainImage: string;
  topImage: string;
  bottomImage: string;
  title: string;
  description?: string;
  buttonText?: string;
  buttonHref?: string;
  alt?: string;
}

const {
  mainImage,
  topImage,
  bottomImage,
  title,
  description,
  buttonText = "Mehr erfahren",
  buttonHref = "#",
  alt = "",
} = Astro.props;
---

<section class="xl:px-18 grid grid-cols-1 gap-6 md:h-100 md:grid-cols-3">
  <div class="relative h-100 overflow-hidden md:col-span-2">
    <img
      src={mainImage}
      alt={alt}
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-black/35"></div>

    <div class="relative z-10 flex h-full flex-col items-center justify-center px-6 text-center text-white">
      <h2 class="max-w-2xl text-2xl font-bold font-manrope tracking-tight md:text-[2.2rem]">
        {title}
      </h2>

      {description && (
        <p class="mt-4 max-w-xl text-base md:text-[1.2rem]">{description}</p>
      )}

      <a
        href={buttonHref}
        class="mt-6 inline-flex items-center justify-center border-2 px-6 py-2 font-semibold text-white transition"
      >
        {buttonText}
      </a>
    </div>
  </div>

  <div class="grid grid-rows-2 gap-6 md:h-100">
    <img src={topImage} alt="" class="h-100 w-full object-cover md:h-full rotate-2" />
    <img src={bottomImage} alt="" class="h-100 w-full object-cover md:h-full" />
  </div>
</section>
