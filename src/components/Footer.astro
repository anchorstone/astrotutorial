---
const year = new Date().getFullYear();

const socialLinks = [
  { name: "Instagram", href: "https://instagram.com/", label: "Auf Instagram besuchen" },
  { name: "LinkedIn", href: "https://linkedin.com/", label: "Auf LinkedIn besuchen" },
  { name: "GitHub", href: "https://github.com/", label: "Auf GitHub besuchen" },
];

const footerLinks = [
  { label: "Impressum", href: "/impressum" },
  { label: "Datenschutz", href: "/datenschutz" },
  { label: "Kontakt", href: "mailto:hallo@deinestudio.de" },
];
---

<footer class="relative overflow-hidden bg-[#101916] text-white">
  <div class="pointer-events-none absolute -right-24 -top-40 h-80 w-80 rounded-full bg-emerald-400/10 blur-3xl" aria-hidden="true"></div>

  <div class="relative mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 sm:py-9">
    <div class="grid gap-8 border-b border-white/10 pb-8 sm:grid-cols-2 lg:grid-cols-[1.35fr_0.8fr_1fr] lg:gap-10">
      <div class="max-w-sm">
        <a href="/" class="inline-flex items-center gap-3 rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-300" aria-label="Dein Studio – zur Startseite">
          <span class="grid h-10 w-10 place-items-center rounded-xl bg-emerald-300 text-[#101916]" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" class="h-5 w-5"><path d="M5 17.5 12 5l7 12.5H5Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M9 14h6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </span>
          <span class="text-lg font-semibold tracking-tight">Dein Studio<span class="text-emerald-300">.</span></span>
        </a>
        <p class="mt-3 text-sm leading-5 text-white/60">Gute Ideen verdienen einen starken Auftritt. Wir gestalten digitale Erlebnisse, die Menschen verbinden.</p>
        <div class="mt-4 flex items-center gap-2.5">
          {socialLinks.map(({ name, href, label }) => (
            <a href={href} aria-label={label} target="_blank" rel="noreferrer" class="grid h-9 w-9 place-items-center rounded-full border border-white/15 text-white/65 transition hover:border-emerald-300 hover:bg-emerald-300 hover:text-[#101916] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-300">
              {name === "Instagram" && <svg viewBox="0 0 24 24" fill="none" class="h-[18px] w-[18px]" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.7"/><circle cx="17.5" cy="6.8" r="1" fill="currentColor"/></svg>}
              {name === "LinkedIn" && <svg viewBox="0 0 24 24" fill="currentColor" class="h-[18px] w-[18px]" aria-hidden="true"><path d="M5.2 8.7a1.8 1.8 0 1 0 0-3.6 1.8 1.8 0 0 0 0 3.6ZM3.7 10h3v10h-3V10Zm5 0h2.9v1.4h.1a3.2 3.2 0 0 1 2.9-1.6c3.1 0 3.7 2 3.7 4.6V20h-3v-5c0-1.2 0-2.8-1.7-2.8s-2 1.3-2 2.7V20h-3V10Z"/></svg>}
              {name === "GitHub" && <svg viewBox="0 0 24 24" fill="currentColor" class="h-[18px] w-[18px]" aria-hidden="true"><path fill-rule="evenodd" d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.87c-2.78.6-3.37-1.18-3.37-1.18-.45-1.15-1.11-1.46-1.11-1.46-.91-.62.07-.61.07-.61 1 .07 1.52 1.03 1.52 1.03.9 1.52 2.35 1.08 2.92.83.09-.65.35-1.08.64-1.33-2.22-.25-4.56-1.11-4.56-4.95 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.56 9.56 0 0 1 5 0c1.9-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.85-2.34 4.69-4.57 4.94.36.31.68.92.68 1.86v2.74c0 .26.18.57.69.48A10 10 0 0 0 12 2Z" clip-rule="evenodd"/></svg>}
            </a>
          ))}
        </div>
      </div>

      <nav aria-label="Rechtliches">
        <h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-emerald-300">Gut zu wissen</h2>
        <ul class="mt-3 space-y-2">
          {footerLinks.map(({ label, href }) => <li><a href={href} class="text-sm text-white/65 transition hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-300">{label}</a></li>)}
        </ul>
      </nav>

      <address class="not-italic">
        <h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-emerald-300">Lass uns sprechen</h2>
        <a href="mailto:hallo@deinestudio.de" class="mt-3 inline-block text-base font-medium tracking-tight transition hover:text-emerald-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-300">hallo@deinestudio.de</a>
        <p class="mt-2 text-sm leading-5 text-white/60">Musterstraße 12<br />10115 Berlin</p>
        <a href="tel:+493055501234" class="mt-2 inline-block text-sm text-white/65 transition hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-300">+49 (0) 30 555 01 234</a>
      </address>
    </div>

    <div class="flex flex-col gap-2 pt-4 text-xs text-white/45 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} Dein Studio. Mit Sorgfalt gestaltet.</p>
      <a href="#top" class="inline-flex items-center gap-2 transition hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-300">Zurück nach oben <span aria-hidden="true">↑</span></a>
    </div>
  </div>
</footer>
