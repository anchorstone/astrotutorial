---
// src/components/SocialBar.astro
// Nutzung: <SocialBar instagram="..." facebook="..." whatsapp="491701234567" email="info@beispiel.de" />

interface Props {
  instagram?: string; // z.B. https://instagram.com/deinprofil
  facebook?: string; // z.B. https://facebook.com/deineseite
  whatsapp?: string; // Nummer mit Ländervorwahl, ohne + (z.B. 491701234567)
  email?: string; // z.B. info@beispiel.de
  class?: string;
}

const {
  instagram = "https://instagram.com/",
  facebook = "https://facebook.com/",
  whatsapp = "491701234567",
  email = "info@beispiel.de",
  class: extra = "",
} = Astro.props;

const links = [
  {
    label: "Instagram",
    href: instagram,
    external: true,
    hover:
      "hover:bg-gradient-to-tr hover:from-amber-400 hover:via-pink-500 hover:to-purple-600",
    path: "M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2Zm-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.4 5.6 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.6 18.4 4 16.4 4H7.6Zm9.65 1.5a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z",
  },
  {
    label: "Facebook",
    href: facebook,
    external: true,
    hover: "hover:bg-[#1877F2]",
    path: "M13.5 22v-8.2h2.8l.5-3.3h-3.3V8.4c0-.9.4-1.7 1.8-1.7h1.6V3.8s-1.4-.3-2.8-.3c-2.9 0-4.6 1.7-4.6 4.8v2.2H6.7v3.3h2.8V22h4Z",
  },
  {
    label: "WhatsApp",
    href: `https://wa.me/${whatsapp}`,
    external: true,
    hover: "hover:bg-[#25D366]",
    path: "M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.700 6.700 0 0 1-3.300-2.900c-.2-.4.2-.4.700-1.300.1-.2 0-.3 0-.5l-.8-1.800c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.2.300-.9.900-.9 2.200s.9 2.500 1.100 2.700c.1.200 1.900 2.900 4.600 4 .600.300 1.100.4 1.500.5.600.2 1.200.2 1.600.1.500-.1 1.500-.6 1.700-1.200.2-.6.2-1.100.2-1.200-.1-.2-.3-.2-.5-.3Z",
  },
  {
    label: "E-Mail",
    href: `mailto:${email}`,
    external: false,
    hover: "hover:bg-slate-900 dark:hover:bg-white dark:hover:text-slate-900",
    path: "M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm0 2v.5l8 5.2 8-5.2V6H4Zm16 2.9-7.500 4.900a1 1 0 0 1-1 0L4 8.900V18h16V8.900Z",
  },
];
---

<nav
  aria-label="Social Media und Kontakt"
  class:list={[
    "inline-flex items-center gap-2 rounded-full border border-white/40 bg-white/70 p-2 shadow-lg shadow-slate-900/5 ring-1 ring-slate-900/5 backdrop-blur-md",
    "dark:border-white/10 dark:bg-slate-900/60 dark:ring-white/5",
    extra,
  ]}
>
  <ul class="flex items-center gap-4">
    {links.map((l) => (
      <li>
        <a
          href={l.href}
          aria-label={l.label}
          title={l.label}
          target={l.external ? "_blank" : undefined}
          rel={l.external ? "noopener noreferrer" : undefined}
          class:list={[
            "group flex h-11 w-11 items-center justify-center rounded-full",
            "bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-200",
            "transition duration-200 ease-out motion-reduce:transition-none",
            "hover:-translate-y-0.5 hover:text-white hover:shadow-md motion-reduce:hover:translate-y-0",
            "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-slate-900 dark:focus-visible:ring-white dark:focus-visible:ring-offset-slate-900",
            l.hover,
          ]}
        >
          <svg
            viewBox="0 0 24 24"
            fill="currentColor"
            class="h-6 w-6"
            aria-hidden="true"
          >
            <path d={l.path} />
          </svg>
        </a>
      </li>
    ))}
  </ul>
</nav>
